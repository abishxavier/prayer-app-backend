# Example .env file — copy to .env and fill in real values (do NOT commit .env)
DATABASE_URL=postgresql://db_user:db_password@db_host:5432/db_name
JWT_SECRET=your_jwt_secret_here
FIREBASE_CREDENTIALS_PATH=app/core/firebase-service-account.json
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# Gmail SMTP for OTP emails
# 1. Enable 2-Step Verification on your Google account
# 2. Go to myaccount.google.com → Security → App passwords
# 3. Create an App Password for "Mail" and paste it below (NOT your regular Gmail password)
SMTP_EMAIL=your_gmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
